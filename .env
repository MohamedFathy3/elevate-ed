# Server Configuration
VITE_DEV_SERVER_HOST=moahemd
VITE_DEV_SERVER_PORT=7000
VITE_PREVIEW_SERVER_HOST=::
VITE_PREVIEW_SERVER_PORT=3000
VITE_USE_HOST=false
# API Configuration
VITE_API_TARGET=https://web-lec.com/
VITE_API_REWRITE_PATH=/api
VITE_API_HEADER_NAME=X-Requested-With
VITE_API_HEADER_VALUE=XMLHttpRequest
VITE_SANCTUM_TARGET=https://web-lec.com/

# Allowed Hosts (comma separated)
VITE_ALLOWED_HOSTS=web-lec.com,localhost,127.0.0.1,::1,.lms.cloud,.web-lec.com
# Environment
NODE_ENV=development